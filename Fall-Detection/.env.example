# Optional local configuration.
# The Windows launcher sets CARE_LOOP_API_URL automatically for the desktop app.
CARE_LOOP_API_URL=http://127.0.0.1:8000
# Leave empty for loopback-only local development; use the same secret for API and desktop processes if enabled.
CARE_LOOP_API_KEY=
# Defaults to data/care_loop.db when unset.
CARE_LOOP_DB_PATH=data/care_loop.db
